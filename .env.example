# GitPulse Environment Configuration Example
# Copy this file to .env and provide your credentials

# GitHub OAuth Application credentials
# Create at https://github.com/settings/developers
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"
# The callback URL matching your GitHub OAuth app settings:
GITHUB_OAUTH_CALLBACK_URL="https://ais-dev-h6tlqskarark7g3lng4trv-737608087133.asia-southeast1.run.app/auth/callback"

# Database Connection (PostgreSQL)
# e.g., postgresql://postgres:password@localhost:5432/gitpulse
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gitpulse"

# Session & Security Keys
# SESSION_SECRET: random 32+ character string for signing session cookies
SESSION_SECRET="gitpulse-secure-session-secret-replace-in-production-32c"

# TOKEN_ENCRYPTION_KEY: 32-byte hex string (64 characters) for AES-256-GCM token encryption
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Application URL (AI Studio automatically injects this in production)
APP_URL="https://ais-dev-h6tlqskarark7g3lng4trv-737608087133.asia-southeast1.run.app"
